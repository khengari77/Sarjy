  "components": {
    "schemas": {
      "AgentInput": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "text"
        ],
        "title": "AgentInput"
      },
      "AgentOutput": {
        "properties": {
          "turn_id": {
            "type": "string",
            "title": "Turn Id"
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "title": "Text"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "interrupted",
              "failed"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "turn_id",
          "text",
          "status"
        ],
        "title": "AgentOutput"
      },
      "BudgetReservation": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "elevenlabs"
            ],
            "title": "Provider"
          },
          "characters": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Characters",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "provider"
        ],
        "title": "BudgetReservation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelChoice": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "ar"
          },
          "voice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "title": "ModelChoice"
      },
      "PipelineConfig": {
        "properties": {
          "runtime": {
            "type": "string",
            "const": "livekit_remote",
            "title": "Runtime",
            "default": "livekit_remote"
          },
          "stt": {
            "$ref": "#/components/schemas/ModelChoice"
          },
          "llm": {
            "$ref": "#/components/schemas/ModelChoice"
          },
          "tts": {
            "$ref": "#/components/schemas/ModelChoice"
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 800.0,
            "minimum": 32.0,
            "title": "Max Output Tokens",
            "default": 96
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stt",
          "llm",
          "tts"
        ],
        "title": "PipelineConfig"
      },
      "StartVoice": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Language",
            "default": "en"
          },
          "voice_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Id"
          }
        },
        "type": "object",
        "required": [
          "conversation_id"
        ],
        "title": "StartVoice"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VoiceCatalog": {
        "properties": {
          "voices": {
            "items": {
              "$ref": "#/components/schemas/VoiceOption"
            },
            "type": "array",
            "title": "Voices"
          },
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Page Token"
          }
        },
        "type": "object",
        "required": [
          "voices"
        ],
        "title": "VoiceCatalog"
      },
      "VoiceOption": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Languages",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "VoiceOption"
      },
      "WeatherInput": {
        "properties": {
          "turn_id": {
            "type": "string",
            "title": "Turn Id"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Request Id"
          },
          "city": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "City"
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          }
        },
        "type": "object",
        "required": [
          "turn_id",
          "request_id",
          "city"
        ],
        "title": "WeatherInput"
      }
    }
  }
}
