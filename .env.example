DATABASE_URL=sqlite+aiosqlite:///./sarjy.db
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=deepseek_direct
DEEPSEEK_API_KEY=
DEEPSEEK_BUDGET_ENABLED=true
DEEPSEEK_DAILY_MICRO_USD=250000
DEEPSEEK_REQUEST_MICRO_USD=7000
ELEVEN_API_KEY=
# Text-to-speech provider: deepgram (default, Aura-2, English only) or elevenlabs (needed for Arabic).
TTS_PROVIDER=deepgram
# Jev UI-command classifier (empty key or JEV_COMMANDS_ENABLED=false disables it).
JEV_API_KEY=
JEV_COMMANDS_ENABLED=true
JEV_DAILY_REQUESTS=2000
# Shared daily TTS character reservations, one ledger per provider (application guard, not a provider quota).
DEEPGRAM_DAILY_CHARACTERS=50000
ELEVENLABS_DAILY_CHARACTERS=2500
# Optional: a comma-separated allow-list and a default voice id. Voice is a per-session
# user setting; with neither configured, a call with no saved or requested voice is
# refused with VOICE_DEFAULT_UNCONFIGURED instead of preventing startup.
APPROVED_VOICE_IDS=
DEFAULT_VOICE_ID=
DEFAULT_VOICE_LANGUAGE=en
API_INTERNAL_URL=http://localhost:8000
AGENT_SERVICE_SECRET=
COOKIE_SECURE=false
# Optional turn-endpointing delays in seconds (0.05-6.0); unset keeps the SDK defaults of 0.5 and 3.0.
# ENDPOINTING_MIN_DELAY_SECONDS=
# ENDPOINTING_MAX_DELAY_SECONDS=

# Accounts (email and password). Set the same switch for the API and the web app; replaces the shared
# token and the reviewer invitations. Needs DEVELOPMENT_PROTECTED, COOKIE_SECURE and WEB_SERVICE_SECRET.
ACCOUNT_ACCESS_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Web app only: provider buttons (google,apple,github,azure,facebook) and the Supabase URL they start from.
OAUTH_PROVIDERS=

# Required for hosted development; never deploy with protection disabled.
DEVELOPMENT_PROTECTED=false
# Shared reviewer token: 32 random bytes, base64url-encoded (for example
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`). Not a memorable word.
REVIEW_ACCESS_TOKEN=
# Admissions, one per new browser. A browser that already holds a valid
# session does not consume another use.
REVIEW_ACCESS_MAX_USES=20
# Absolute ISO-8601 UTC instant. Required in protected mode and authoritative:
# nothing extends it, and the session cookie dies at the same instant. Set it
# in the past to revoke. A missing or invalid value refuses to boot.
REVIEW_ACCESS_EXPIRES_AT=
# Usage-counter file (default /tmp/sarjy-review-access-state.json, writable in
# the adapter-node container). Counters reset if this file is lost; time still
# bounds access.
REVIEW_ACCESS_STATE_PATH=
# Reviewer invitations: a second, revocable door backed by per-invitation
# identities in the API database. Set the same value on the API and the web app.
# When enabled, /review and the invitation exchange stay reachable without the
# shared token, and a valid reviewer cookie authorises API calls. The shared
# token door stays in force for every other page.
REVIEWER_ACCESS_ENABLED=false
# Behind a proxy, tell adapter-node which header carries the client address so
# the per-visitor failure cap is not one shared socket bucket.
ADDRESS_HEADER=
XFF_DEPTH=
# Signs the session cookie. Falls back to WEB_SERVICE_SECRET when unset.
SESSION_SECRET=
WEB_SERVICE_SECRET=
