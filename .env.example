DATABASE_URL=sqlite+aiosqlite:///./sarjy.db
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=deepseek_direct
DEEPSEEK_API_KEY=
DEEPSEEK_BUDGET_ENABLED=true
DEEPSEEK_DAILY_MICRO_USD=250000
DEEPSEEK_REQUEST_MICRO_USD=7000
ELEVEN_API_KEY=
# Required once ELEVEN_API_KEY is set: a non-empty comma-separated allow-list or a
# default voice id. Startup fails when both are empty, so the demo cannot admit a
# call with no approved voice.
APPROVED_VOICE_IDS=
DEFAULT_VOICE_ID=
DEFAULT_VOICE_LANGUAGE=en
API_INTERNAL_URL=http://localhost:8000
AGENT_SERVICE_SECRET=
COOKIE_SECURE=false
DEMO_SESSION_BUDGET=80
DEMO_CALLS_PER_IDENTITY=3

# Required for hosted development; never deploy with protection disabled.
DEVELOPMENT_PROTECTED=false
# Shared reviewer token: 32 random bytes, base64url-encoded (for example
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`). Not a memorable word.
REVIEW_ACCESS_TOKEN=
# Admissions, one per new browser. A browser that already holds a valid
# session does not consume another use.
REVIEW_ACCESS_MAX_USES=20
# Absolute ISO-8601 UTC instant. Required in protected mode and authoritative:
# nothing extends it, and the session cookie dies at the same instant. Set it
# in the past to revoke. A missing or invalid value refuses to boot.
REVIEW_ACCESS_EXPIRES_AT=
# Usage-counter file (defaults to .sarjy/review-access-state.json). Counters
# reset if this file is lost; time still bounds access.
REVIEW_ACCESS_STATE_PATH=
# Signs the session cookie. Falls back to WEB_SERVICE_SECRET when unset.
SESSION_SECRET=
WEB_SERVICE_SECRET=
