{
  "name": "@sarjy/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "playwright test",
  "test:deadline": "playwright test --config playwright.deadline.config.ts",
    "test:videos": "playwright test --config playwright.recording.config.ts --grep \"demo session|voice picker\" --workers 1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "dependencies": {
    "livekit-client": "2.23.0"
  },
  "packageManager": "pnpm@10.32.1"
}
