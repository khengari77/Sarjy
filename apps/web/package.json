{
  "name": "@sarjy/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "svelte-kit sync && vitest run",
    "test:browser": "playwright test",
    "test:deadline": "playwright test --config playwright.deadline.config.ts",
    "test:videos": "playwright test --config playwright.recording.config.ts --grep \"demo session|voice picker\" --workers 1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.1.18",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "livekit-client": "2.23.0"
  },
  "packageManager": "pnpm@10.32.1"
}
